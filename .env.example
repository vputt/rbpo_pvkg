# Пример набора настроек приложения. Учебные значения, настоящих секретов здесь нет.
# Скопируйте файл в .env и подставьте локальные значения:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).
# Приложение само .env не читает: переменные нужно экспортировать в окружение,
# как описано в README, раздел "Запуск".

# Адрес, на котором слушает HTTP API. Необязательная, по умолчанию localhost:8080.
PVKG_ADDR=localhost:8080

# Строка подключения к PostgreSQL. ОБЯЗАТЕЛЬНАЯ: без неё сервер не запускается.
# Пароль ниже - учебная заглушка для локальной базы, не используйте её вне локального стенда.
PVKG_DB_DSN=postgres://pvkg:pvkg_local_password@localhost:5432/pvkg?sslmode=disable

# Срок жизни серверной сессии (решение D-01). Необязательная, по умолчанию 8h.
PVKG_SESSION_TTL=8h

# Число неудачных попыток входа до блокировки (требование SR-09).
# Необязательная, по умолчанию 5.
PVKG_LOGIN_MAX_FAILS=5

# Срок блокировки после превышения порога попыток (требование SR-09).
# Необязательная, по умолчанию 15m.
PVKG_LOGIN_LOCK_FOR=15m
